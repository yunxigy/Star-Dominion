.workbench {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #d9d9ee;
  border-radius: 24rpx;
  background: #fff;
}

.field-group,
.utm-grid {
  margin-top: 4rpx;
}

.field-label {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #40395e;
  font-size: 25rpx;
  font-weight: 600;
}

.text-input,
.tool-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid #ddd8ec;
  border-radius: 16rpx;
  background: #faf9ff;
  color: #302a49;
  font-size: 26rpx;
}

.tool-textarea {
  min-height: 230rpx;
  line-height: 1.6;
}

.small-textarea {
  min-height: 150rpx;
}

.utm-grid {
  display: grid;
  gap: 12rpx;
}

.action-row,
.output-header {
  display: flex;
  gap: 14rpx;
}

.action-row {
  margin-top: 22rpx;
}

.primary-button,
.secondary-button,
.copy-button {
  border: 0;
  border-radius: 14rpx;
  font-size: 23rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
}

.primary-button {
  color: #fff;
  background: #6258a8;
}

.secondary-button {
  color: #554f75;
  background: #eeebf8;
}

.error-message {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #a33d32;
  background: #fff0ed;
  font-size: 24rpx;
}

.output-card {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f6f3fb;
}

.output-header {
  align-items: center;
  justify-content: space-between;
}

.output-title {
  color: #40395e;
  font-size: 26rpx;
  font-weight: 600;
}

.copy-button {
  min-width: 100rpx;
  margin: 0;
  color: #5b50a2;
  background: #fff;
}

.output-scroll {
  max-height: 560rpx;
  margin-top: 14rpx;
}

.output-text {
  color: #3d3659;
  font-family: monospace;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
