.workbench {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 24rpx;
  background: #fff;
}

.mode-switch,
.action-row,
.output-header {
  display: flex;
  gap: 16rpx;
}

.mode-switch {
  margin-bottom: 24rpx;
}

.mode-button,
.primary-button,
.secondary-button,
.copy-button {
  box-sizing: border-box;
  border: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 2.2;
}

.mode-button {
  flex: 1;
  color: #806b59;
  background: #fbf6ef;
}

.mode-button-active {
  color: #fff;
  background: #b66b3d;
}

.field-label {
  margin-bottom: 12rpx;
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-textarea {
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid #eadfce;
  border-radius: 16rpx;
  background: #fffdf9;
  color: #392b20;
  font-size: 26rpx;
  line-height: 1.6;
}

.action-row {
  margin-top: 20rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
}

.primary-button {
  color: #fff;
  background: #b66b3d;
}

.secondary-button {
  color: #745d4b;
  background: #f3e9dc;
}

.success-message,
.error-message {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.success-message {
  color: #527037;
  background: #f1f7e8;
}

.error-message {
  color: #a33d32;
  background: #fff0ed;
}

.output-card {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8f3ec;
}

.output-header {
  align-items: center;
  justify-content: space-between;
}

.output-title {
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.copy-button {
  min-width: 100rpx;
  margin: 0;
  color: #8b5738;
  background: #fff;
}

.output-scroll {
  max-height: 560rpx;
  margin-top: 16rpx;
}

.output-text {
  color: #3e3026;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
