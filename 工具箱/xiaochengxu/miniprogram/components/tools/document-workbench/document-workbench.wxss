.workbench {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 24rpx;
  background: #fff;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.citation-form,
.pdf-form,
.field-section {
  margin-top: 20rpx;
}

.text-input,
.tool-textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #eadfce;
  border-radius: 16rpx;
  background: #fffdf9;
  color: #392b20;
  font-size: 26rpx;
}

.tool-textarea {
  min-height: 260rpx;
  line-height: 1.6;
}

.small-textarea {
  min-height: 160rpx;
}

.file-name {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  color: #806b59;
  background: #fbf6ef;
  font-size: 23rpx;
  word-break: break-all;
}

.mode-switch,
.action-row,
.output-header {
  display: flex;
  gap: 14rpx;
}

.mode-switch {
  margin: 20rpx 0;
}

.mode-button,
.primary-button,
.secondary-button,
.copy-button {
  border: 0;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 2.4;
}

.mode-button {
  flex: 1;
  color: #806b59;
  background: #fbf6ef;
}

.mode-button-active,
.primary-button {
  color: #fff;
  background: #b66b3d;
}

.action-row {
  margin-top: 22rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
}

.secondary-button {
  color: #745d4b;
  background: #f3e9dc;
}

.error-message {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #a33d32;
  background: #fff0ed;
  font-size: 24rpx;
}

.output-card {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8f3ec;
}

.output-header {
  align-items: center;
  justify-content: space-between;
}

.output-title {
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.copy-button {
  min-width: 100rpx;
  margin: 0;
  color: #8b5738;
  background: #fff;
}

.output-scroll {
  max-height: 520rpx;
  margin-top: 14rpx;
}

.output-text {
  color: #3e3026;
  font-family: monospace;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
