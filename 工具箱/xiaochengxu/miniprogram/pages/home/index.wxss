page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
}

.hero-card {
  padding: 34rpx 30rpx 30rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fffdf9, #f9eedf);
  box-shadow: 0 18rpx 42rpx rgba(122, 66, 27, 0.08);
}

.eyebrow {
  color: #9a5a28;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #2f241b;
  font-size: 56rpx;
  font-weight: 700;
}

.hero-description {
  margin-top: 10rpx;
  color: #806b59;
  font-size: 26rpx;
  line-height: 1.55;
}

.search-box {
  margin-top: 26rpx;
}

.search-history {
  margin-top: 22rpx;
}

.search-history-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.search-history-title {
  color: #9b8775;
  font-size: 22rpx;
}

.search-history-clear {
  color: #ad8d70;
  font-size: 22rpx;
}

.search-history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.history-tag {
  padding: 8rpx 20rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 999rpx;
  background: #fffdf9;
  color: #6b5847;
  font-size: 22rpx;
  line-height: 1.5;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}

.section-heading-tools {
  margin-top: 38rpx;
}

.section-title {
  color: #2f241b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-count {
  color: #9b8775;
  font-size: 23rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.category-card {
  min-width: 0;
  padding: 24rpx 22rpx 22rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(122, 66, 27, 0.05);
}

.category-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.category-icon-badge {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #faf3e8;
  border: 1rpx solid #ead9c3;
  font-size: 32rpx;
  line-height: 1;
}

.category-card-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}

.category-name {
  min-width: 0;
  color: #49382b;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.category-count {
  flex: 0 0 auto;
  color: #ad8d70;
  font-size: 20rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.category-description {
  display: block;
  margin-top: 14rpx;
  min-height: 66rpx;
  color: #806b59;
  font-size: 22rpx;
  line-height: 1.5;
}

.category-action {
  display: block;
  margin-top: 16rpx;
  color: #b66b3d;
  font-size: 21rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.search-hint {
  margin-top: 26rpx;
  color: #9b8775;
  font-size: 23rpx;
  text-align: center;
}
