<scroll-view class="page-scroll" scroll-y type="list">
  <view class="tool-page">
    <tool-header title="{{title}}" description="{{description}}" bindback="goBack" />
    <dev-workbench
      wx:if="{{status === 'ready' && workbench === 'dev'}}"
      tool-id="{{id}}"
    />
    <calculator-workbench
      wx:elif="{{status === 'ready' && workbench === 'calculator'}}"
      tool-id="{{id}}"
    />
    <text-workbench
      wx:elif="{{status === 'ready' && workbench === 'text'}}"
      tool-id="{{id}}"
    />
    <fun-workbench
      wx:elif="{{status === 'ready' && workbench === 'fun'}}"
      tool-id="{{id}}"
    />
    <assessment-workbench
      wx:elif="{{status === 'ready' && workbench === 'assessment'}}"
      tool-id="{{id}}"
    />
    <tarot-workbench
      wx:elif="{{status === 'ready' && workbench === 'tarot'}}"
      tool-id="{{id}}"
    />
    <image-workbench
      wx:elif="{{status === 'ready' && workbench === 'image'}}"
      tool-id="{{id}}"
    />
    <converter-workbench
      wx:elif="{{status === 'ready' && workbench === 'converter'}}"
      tool-id="{{id}}"
    />
    <request-workbench
      wx:elif="{{status === 'ready' && workbench === 'request'}}"
      tool-id="{{id}}"
    />
    <webmaster-workbench
      wx:elif="{{status === 'ready' && workbench === 'webmaster'}}"
      tool-id="{{id}}"
    />
    <audio-workbench
      wx:elif="{{status === 'desktop-only' && workbench === 'audio'}}"
      tool-id="{{id}}"
    />
    <view wx:elif="{{status === 'ready'}}" class="ready-card">
      <text class="ready-title">工具已就绪</text>
      <text class="ready-description">原生界面正在接入具体功能，请从首页选择其他已完成工具。</text>
    </view>
    <compatibility-notice
      wx:elif="{{status === 'adapting'}}"
      title="原生工具正在迁移"
      description="{{limitation || '工具界面和逻辑会逐批改为原生小程序，完成后即可在这里使用。'}}"
    />
    <empty-state
      wx:else
      title="暂不支持此工具"
      description="该工具依赖桌面端能力，请在网站电脑版使用。"
    />
  </view>
</scroll-view>
