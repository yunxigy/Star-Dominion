page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 4rpx 16rpx;
}

.section-heading-gap {
  margin-top: 44rpx;
}

.section-title {
  color: #2f241b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-action {
  color: #b66b3d;
  font-size: 23rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.empty-card {
  padding: 54rpx 32rpx;
  border: 1rpx dashed #ead9c3;
  border-radius: 24rpx;
  background: #fffdf9;
  text-align: center;
}

.empty-title,
.empty-description {
  display: block;
}

.empty-title {
  color: #2f241b;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-description {
  margin-top: 14rpx;
  color: #806b59;
  font-size: 23rpx;
  line-height: 1.6;
}

.profile-footer {
  margin-top: 56rpx;
  text-align: center;
}

.footer-text {
  color: #b3a392;
  font-size: 22rpx;
}