{
  "version": 1,
  "services": [
    {
      "name": "plagiarism",
      "working_directory": "工具箱/plagiarism",
      "executable": "python",
      "arguments": [
        "main.py"
      ],
      "ports": [
        8005
      ],
      "health_url": "http://127.0.0.1:8005/api/plagiarism/health"
    },
    {
      "name": "research-reports",
      "working_directory": "工具箱/research-reports",
      "executable": "python",
      "arguments": [
        "-m",
        "uvicorn",
        "research_reports.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8009"
      ],
      "ports": [
        8009
      ],
      "health_url": "http://127.0.0.1:8009/health"
    },
    {
      "name": "document-converter",
      "working_directory": "工具箱/document-converter",
      "executable": "python",
      "arguments": [
        "-m",
        "uvicorn",
        "document_converter.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "ports": [
        8010
      ],
      "health_url": "http://127.0.0.1:8010/health"
    },
    {
      "name": "video-downloader",
      "working_directory": "工具箱/video-downloader",
      "executable": "python",
      "arguments": [
        "-m",
        "uvicorn",
        "video_downloader.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8011",
        "--workers",
        "1"
      ],
      "ports": [
        8011
      ],
      "health_url": "http://127.0.0.1:8011/health"
    },
    {
      "name": "webmaster-inspector",
      "working_directory": "工具箱/webmaster-inspector",
      "executable": "python",
      "arguments": [
        "-m",
        "uvicorn",
        "webmaster_inspector.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8012",
        "--workers",
        "1"
      ],
      "ports": [
        8012
      ],
      "health_url": "http://127.0.0.1:8012/health"
    },
    {
      "name": "sd-frontend",
      "working_directory": "工具箱/SD",
      "executable": "node",
      "arguments": [
        "node_modules/vite/bin/vite.js",
        "--host",
        "127.0.0.1",
        "--port",
        "8013"
      ],
      "ports": [
        8013
      ],
      "health_url": "http://127.0.0.1:8013/",
      "frontend": true
    }
  ]
}
