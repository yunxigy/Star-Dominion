# Copy this file to .env.local for local runs.
# Never commit .env.local or real API keys.

# Default LLM provider. Use AGENT_PROVIDER=deepseek for DeepSeek-compatible relays.
AGENT_PROVIDER=bigmodel
BIGMODEL_API_KEY=
BIGMODEL_MODEL=glm-4.7-flash
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional DeepSeek-compatible provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_RETRY=1
DEEPSEEK_MAX_TOKENS_FALLBACK=8192

# Default search provider: Bocha
# SEARCH_PROVIDER selects the search backend per environment: bocha (default) | bing (keyless) | jina | none.
# Per-request/CLI selection still takes precedence over this variable.
SEARCH_PROVIDER=
BOCHA_API_KEY=
BOCHA_TIMEOUT_MS=60000
BOCHA_RETRY=2
BOCHA_COUNT=10
BOCHA_MAX_COUNT=50
BOCHA_FRESHNESS=noLimit
BOCHA_SUMMARY=true

# Optional Jina fallback. Jina is no longer used by default.
JINA_API_KEY=
JINA_TIMEOUT_MS=90000
JINA_RETRY=3
JINA_MAX_NUM=20
# Fetch mode: direct (default, origin only) | jina (reader only) | fallback (origin first, Jina Reader on failure).
# FETCH_MODE takes precedence over the legacy FETCH_USE_JINA_READER switch.
FETCH_MODE=
FETCH_USE_JINA_READER=0
JINA_READER_TIMEOUT_MS=90000
JINA_READER_RETRY=2
JINA_READER_MAX_CHARS=180000

# Direct fetch-page defaults used when FETCH_MODE=direct (or unset and FETCH_USE_JINA_READER=0).
FETCH_TIMEOUT_MS=30000
FETCH_RETRY=1
FETCH_MAX_CHARS=180000

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.5
OPENAI_WIRE_API=chat_completions
AGENT_REASONING_EFFORT=low

# Optional server settings
PORT=8787
