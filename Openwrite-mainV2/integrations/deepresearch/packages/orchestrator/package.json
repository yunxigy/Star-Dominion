{
  "name": "@deepresearch/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: not configured yet'"
  },
  "dependencies": {
    "@deepresearch/contracts": "workspace:*",
    "@deepresearch/embedding-providers": "workspace:*",
    "@deepresearch/knowledge-graph": "workspace:*",
    "@deepresearch/memory-graph": "workspace:*",
    "@deepresearch/net-utils": "workspace:*",
    "@deepresearch/task-ledger": "workspace:*",
    "@deepresearch/tool-providers": "workspace:*",
    "better-sqlite3": "12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  },
  "files": [
    "dist",
    "!dist/tests",
    "!dist/__tests__",
    "!dist/**/__tests__"
  ],
  "bin": {
    "deepresearch": "./dist/cli.js"
  }
}
