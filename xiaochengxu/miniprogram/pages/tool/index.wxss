page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.tool-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 64rpx;
}

.migration-card {
  padding: 52rpx 32rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.ready-card {
  padding: 52rpx 32rpx;
  border: 1rpx solid #d9e4c7;
  border-radius: 24rpx;
  background: #f8fbf2;
  text-align: center;
}

.ready-title {
  display: block;
  color: #4f6b32;
  font-size: 32rpx;
  font-weight: 700;
}

.ready-description {
  display: block;
  margin-top: 16rpx;
  color: #667756;
  font-size: 24rpx;
  line-height: 1.7;
}

.migration-title,
.migration-description {
  display: block;
}

.migration-title {
  color: #2f241b;
  font-size: 32rpx;
  font-weight: 700;
}

.migration-description {
  margin-top: 16rpx;
  color: #806b59;
  font-size: 24rpx;
  line-height: 1.7;
}
