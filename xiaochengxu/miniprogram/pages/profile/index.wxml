<scroll-view class="page-scroll" scroll-y type="list">
  <view class="profile-page">
    <view class="section-heading">
      <text class="section-title">最近使用</text>
      <text wx:if="{{recentTools.length > 0}}" class="section-action" bindtap="clearRecent">清空</text>
    </view>
    <view wx:if="{{recentTools.length === 0}}" class="empty-card">
      <text class="empty-title">还没有使用记录</text>
      <text class="empty-description">在首页或分类页打开任意工具，就会出现在这里。</text>
    </view>
    <view wx:else class="tool-grid">
      <tool-card wx:for="{{recentTools}}" wx:key="id" tool="{{item}}" bindtap="openTool" />
    </view>

    <view class="section-heading section-heading-gap">
      <text class="section-title">我的收藏</text>
      <text wx:if="{{favoriteTools.length > 0}}" class="section-action" bindtap="goHome">浏览更多</text>
    </view>
    <view wx:if="{{favoriteTools.length === 0}}" class="empty-card">
      <text class="empty-title">还没有收藏</text>
      <text class="empty-description">使用工具时长按或点击工具页的收藏按钮，即可收藏到这里。</text>
    </view>
    <view wx:else class="tool-grid">
      <tool-card wx:for="{{favoriteTools}}" wx:key="id" tool="{{item}}" bindtap="openTool" />
    </view>

    <view class="profile-footer">
      <text class="footer-text">数据保存在本机，不上传云端</text>
    </view>
  </view>
</scroll-view>