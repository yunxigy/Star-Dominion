page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
}

.category-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx 64rpx;
}

.page-heading {
  padding: 28rpx 4rpx 24rpx;
}

.page-title {
  display: block;
  color: #2f241b;
  font-size: 48rpx;
  font-weight: 700;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  color: #806b59;
  font-size: 25rpx;
}

.empty-card {
  padding: 54rpx 32rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.empty-title,
.empty-description {
  display: block;
}

.empty-title {
  color: #2f241b;
  font-size: 31rpx;
  font-weight: 700;
}

.empty-description {
  margin-top: 16rpx;
  color: #806b59;
  font-size: 24rpx;
  line-height: 1.6;
}

.page-heading .search-box {
  margin-top: 24rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
