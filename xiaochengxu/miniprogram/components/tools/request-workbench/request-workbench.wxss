.workbench {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #ead9c3;
  border-radius: 24rpx;
  background: #fff;
}

.notice-card {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f7f5ed;
}

.notice-title,
.notice-text {
  display: block;
}

.notice-title {
  color: #52643b;
  font-size: 25rpx;
  font-weight: 700;
}

.notice-text {
  margin-top: 8rpx;
  color: #776f5f;
  font-size: 22rpx;
  line-height: 1.6;
}

.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.text-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid #eadfce;
  border-radius: 16rpx;
  background: #fffdf9;
  color: #392b20;
  font-size: 26rpx;
}

.action-row,
.output-header,
.error-message {
  display: flex;
  gap: 14rpx;
}

.action-row {
  margin-top: 22rpx;
}

.primary-button,
.secondary-button,
.retry-button,
.copy-button {
  border: 0;
  border-radius: 14rpx;
  font-size: 23rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
}

.primary-button {
  color: #fff;
  background: #b66b3d;
}

.secondary-button {
  color: #745d4b;
  background: #f3e9dc;
}

.error-message {
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #a33d32;
  background: #fff0ed;
  font-size: 24rpx;
}

.retry-button {
  flex: none;
  margin: 0;
  color: #8e4437;
  background: #fff;
}

.output-card {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8f3ec;
}

.output-header {
  align-items: center;
  justify-content: space-between;
}

.output-title {
  color: #49382b;
  font-size: 26rpx;
  font-weight: 600;
}

.copy-button {
  min-width: 100rpx;
  margin: 0;
  color: #8b5738;
  background: #fff;
}

.output-scroll {
  max-height: 560rpx;
  margin-top: 14rpx;
}

.output-text {
  color: #3e3026;
  font-family: monospace;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
