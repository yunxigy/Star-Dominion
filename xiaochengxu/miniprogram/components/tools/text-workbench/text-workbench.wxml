<view class="workbench">
  <view class="field-header">
    <text class="field-label">输入文本</text>
    <button class="copy-button" size="mini" bindtap="copyCurrent">复制</button>
  </view>
  <textarea
    class="tool-textarea"
    value="{{input}}"
    maxlength="-1"
    auto-height
    placeholder="请输入或粘贴文本"
    bindinput="onInput"
  />

  <view wx:if="{{toolId === 'case-converter'}}" class="case-section">
    <view class="field-label">转换类型</view>
    <view class="case-grid">
      <button class="case-button {{mode === 'upper' ? 'case-button-active' : ''}}" data-mode="upper" bindtap="onCaseMode">全部大写</button>
      <button class="case-button {{mode === 'lower' ? 'case-button-active' : ''}}" data-mode="lower" bindtap="onCaseMode">全部小写</button>
      <button class="case-button {{mode === 'capitalize' ? 'case-button-active' : ''}}" data-mode="capitalize" bindtap="onCaseMode">单词首字母大写</button>
      <button class="case-button {{mode === 'sentence' ? 'case-button-active' : ''}}" data-mode="sentence" bindtap="onCaseMode">句首大写</button>
      <button class="case-button case-button-wide {{mode === 'toggle' ? 'case-button-active' : ''}}" data-mode="toggle" bindtap="onCaseMode">大小写反转</button>
    </view>
    <view wx:if="{{output}}" class="output-card">
      <view class="field-header">
        <text class="field-label">转换结果</text>
        <button class="copy-button" size="mini" bindtap="swapOutput">替换输入</button>
      </view>
      <text class="output-text">{{output}}</text>
    </view>
  </view>

  <view wx:if="{{toolId === 'word-count'}}" class="stats-section">
    <view class="stats-title">统计结果</view>
    <view class="stats-grid">
      <view class="stat-item"><text class="stat-number">{{stats.characters}}</text><text class="stat-label">总字符数</text></view>
      <view class="stat-item"><text class="stat-number">{{stats.charactersNoSpaces}}</text><text class="stat-label">不含空格</text></view>
      <view class="stat-item"><text class="stat-number">{{stats.words}}</text><text class="stat-label">词语数</text></view>
      <view class="stat-item"><text class="stat-number">{{stats.chineseChars}}</text><text class="stat-label">中文字符</text></view>
      <view class="stat-item"><text class="stat-number">{{stats.lines}}</text><text class="stat-label">行数</text></view>
      <view class="stat-item"><text class="stat-number">{{stats.paragraphs}}</text><text class="stat-label">段落数</text></view>
    </view>
  </view>

  <button class="clear-button" bindtap="clear">清空</button>
</view>
