{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@site-auth": ["context/ExternalAuthContext.tsx"],
      "@login-page": ["pages/ExternalLoginPage.tsx"],
      "@stm32-page": ["pages/ExternalStm32Page.tsx"],
      "@stm32-window": ["pages/ExternalStm32Page.tsx"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "react-router-dom": ["node_modules/react-router-dom"],
      "lucide-react": ["node_modules/lucide-react"],
      "framer-motion": ["node_modules/framer-motion"],
      "recharts": ["node_modules/recharts"],
      "@amap/amap-jsapi-loader": ["node_modules/@amap/amap-jsapi-loader"],
      "vitest": ["node_modules/vitest"],
      "@testing-library/react": ["node_modules/@testing-library/react"],
      "@testing-library/user-event": ["node_modules/@testing-library/user-event"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".", "**/*.ts", "**/*.tsx", "../../STM32上位机/frontend", "../../登录/frontend"],
  "exclude": ["node_modules", "dist", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
