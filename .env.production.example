# Copy to .env.production on the server. Never commit the real file.
# Generate independent secrets; do not reuse API keys or the administrator password.

SITE_AUTH_URL=http://127.0.0.1:8000
SITE_AUTH_INTERNAL_KEY=
SITE_AUTH_ALLOWED_ORIGINS=https://zhumenggy.top
SITE_AUTH_COOKIE_SECURE=true
SITE_AUTH_DATA_DIR=/www/wwwroot/110.40.174.239/site-auth/data
VITE_SITE_URL=

OPENWRITE_HOST=127.0.0.1
OPENWRITE_PORT=8001

STOCK_ENV=production
STOCK_DATA_DIR=/www/wwwroot/110.40.174.239/stock-research-package/stock-module/data
STOCK_MODEL_MASTER_KEY=
STOCK_GATEWAY_SERVICE_TOKEN=
STOCK_ROUTE_SIGNING_KEY=
STOCK_ANALYSIS_SERVICE_URL=http://127.0.0.1:8003
STOCK_GATEWAY_INTERNAL_URL=http://127.0.0.1:8004/v1
STOCK_XHS_DATA_DIR=/www/wwwroot/110.40.174.239/stock-research-package/stock-module/data/xhs-mcp
STOCK_XHS_MCP_COMMAND=npx -y @sillyl12324/xhs-mcp@2.7.0
STOCK_MARKET_PROXY=
STOCK_MOM_REFRESH_TIME=08:30
STOCK_TIMEZONE=Asia/Shanghai

# Optional platform profiles. Leave empty if users must provide their own model API.
STOCK_PLATFORM_MODEL_PROFILES_JSON=

PLAGIARISM_ALLOWED_ORIGINS=https://zhumenggy.top
SHOUANREN_HOST=127.0.0.1
SHOUANREN_PORT=8006
STM32_HTTP_PORT=8007
STM32_TCP_PORT=8008
STM32_ALLOWED_ORIGINS=https://zhumenggy.top

# Used only while building SD. These values are embedded in frontend assets.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Video parser/downloader. Generate a unique secret of at least 32 characters.
VIDEO_ENVIRONMENT=production
VIDEO_SIGNING_SECRET=
VIDEO_TEMP_DIR=/www/wwwroot/110.40.174.239/runtime/video-downloads
VIDEO_COOKIE_SECURE=true
VIDEO_TRUSTED_PROXIES=127.0.0.1/32,::1/128
VIDEO_DOUYIN_COOKIE_FILE=
VIDEO_FFMPEG_BIN=ffmpeg
# Defaults: session 3600s, parse token 300s, output 1800s, duration 7200s,
# file 2147483648 bytes, concurrency 2, per-IP active 1, queue 8.
