# Copy to .env.local. Keep real values only in that ignored file.
SITE_AUTH_INTERNAL_KEY=
SITE_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SITE_AUTH_COOKIE_SECURE=false
SITE_AUTH_DATA_DIR=data
SITE_AUTH_URL=http://127.0.0.1:8000
VITE_SITE_URL=http://127.0.0.1:5173

# Used only by scripts/check-local.ps1 for an authenticated smoke check.
SITE_ADMIN_IDENTITY=admin
SITE_ADMIN_PASSWORD=

STOCK_ENV=development
STOCK_DATA_DIR=../data
STOCK_MODEL_MASTER_KEY=
STOCK_GATEWAY_SERVICE_TOKEN=
STOCK_ROUTE_SIGNING_KEY=
STOCK_PLATFORM_MODEL_PROFILES_JSON=
STOCK_ANALYSIS_SERVICE_URL=http://127.0.0.1:8003
STOCK_GATEWAY_INTERNAL_URL=http://127.0.0.1:8004/v1
STOCK_XHS_DATA_DIR=stock-research-package/stock-module/data/xhs-mcp
STOCK_XHS_MCP_COMMAND=npx.cmd -y rednote-mcp@0.2.3 --stdio
STOCK_MARKET_PROXY=
STOCK_MOM_REFRESH_TIME=08:30
STOCK_TIMEZONE=Asia/Shanghai
DSA_SOURCE_ROOT=../../upstreams/daily_stock_analysis

PLAGIARISM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STM32_HTTP_PORT=8007
STM32_TCP_PORT=8008
STM32_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHOUANREN_HOST=127.0.0.1
SHOUANREN_PORT=8006

# Standalone GitHub weekly research reports. Token is optional but raises API limits.
RESEARCH_REPORTS_DATA_DIR=data
RESEARCH_REPORTS_TIMEZONE=Asia/Shanghai
RESEARCH_REPORTS_SITE_AUTH_URL=http://127.0.0.1:8000
RESEARCH_REPORTS_HOST=127.0.0.1
RESEARCH_REPORTS_PORT=8009
GITHUB_TOKEN=

# SD frontend maps. Configure these in the build environment; never commit real values.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Optional standalone strategy scripts under stock-research-package/.
SILICONFLOW_API_KEY=
SERVERCHAN_SEND_KEY=

# Research report AI briefing
RESEARCH_REPORTS_AI_PROVIDER=siliconflow
# When STOCK_PLATFORM_MODEL_PROFILES_JSON is configured, the research service
# reuses its enabled SiliconFlow profile and API-key environment variable.
RESEARCH_REPORTS_AI_PROFILE_ID=
RESEARCH_REPORTS_AI_BASE_URL=https://api.siliconflow.cn/v1
RESEARCH_REPORTS_AI_MODEL=deepseek-v4-flash
RESEARCH_REPORTS_AI_TIMEOUT_SECONDS=45

# Video parser/downloader. Live URLs are opt-in test fixtures and must be owned or authorized.
VIDEO_ENVIRONMENT=development
VIDEO_SIGNING_SECRET=
VIDEO_TEMP_DIR=.runtime/video-downloads
VIDEO_COOKIE_SECURE=false
VIDEO_TRUSTED_PROXIES=127.0.0.1/32,::1/128
VIDEO_DOUYIN_COOKIE_FILE=
VIDEO_FFMPEG_BIN=ffmpeg
VIDEO_LIVE_DOUYIN_URL=
VIDEO_LIVE_BILIBILI_URL=
